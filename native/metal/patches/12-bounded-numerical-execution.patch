+// Deliberately small device-region dialect: fixed-trip, small-state indexed
+// maps/recurrences. No reductions, scatter, dot, nested while, custom calls or
+// general function lowering. A single GPU thread owns event order and state.
+#include "pjrt_plugin/ops/device_regions.h"
+
+#include <mlx/fast.h>
+#include <mlx/ops.h>
+
+#include <algorithm>
+#include <sstream>
+#include <unordered_set>
+
+namespace jax_mps {
+namespace {
+constexpr int64_t kMaxTrips = 4096;
+constexpr int64_t kMaxStateElements = 2048;
+constexpr int64_t kMaxTemporaryBytes = 32768;
+constexpr int64_t kMaxElementWork = 4 * 1024 * 1024;
+constexpr size_t kMaxOperations = 512;
+constexpr size_t kMaxCallDepth = 8;
+
+struct Tensor {
+    std::string name;
+    mlir::RankedTensorType type;
+    int64_t size;
+    bool strided = false;
+    std::string at(const std::string& index) const {
+        if (!strided)
+            return name + "[" + index + "]";
+        std::string offset = "0l";
+        int64_t stride = size;
+        for (int d = 0; d < type.getRank(); ++d) {
+            stride /= type.getDimSize(d);
+            offset += "+long(((" + index + ")/" + std::to_string(stride) + ")%" +
+                      std::to_string(type.getDimSize(d)) + ")*" + name + "_strides[" +
+                      std::to_string(d) + "]";
+        }
+        return name + "[" + offset + "]";
+    }
+};
+using Bindings = std::unordered_map<void*, Tensor>;
+
+std::string MetalType(mlir::Type t) {
+    if (t.isF32())
+        return "float";
+    auto i = mlir::dyn_cast<mlir::IntegerType>(t);
+    if (!i)
+        return {};
+    if (i.getWidth() == 1)
+        return "bool";
+    if (i.getWidth() == 32)
+        return i.isUnsigned() ? "uint" : "int";
+    if (i.getWidth() == 64)
+        return i.isUnsigned() ? "ulong" : "long";
+    return {};
+}
+
+std::optional<Tensor> Describe(mlir::Type t, std::string name) {
+    auto type = mlir::dyn_cast<mlir::RankedTensorType>(t);
+    if (!type || !type.hasStaticShape() || type.getRank() > 4 ||
+        MetalType(type.getElementType()).empty())
+        return std::nullopt;
+    int64_t size = 1;
+    for (int64_t dim : type.getShape()) {
+        if (dim <= 0 || dim > (1 << 20) || size > (1 << 20) / dim)
+            return std::nullopt;
+        size *= dim;
+    }
+    return Tensor{std::move(name), type, size};
+}
+
+std::string Coordinate(const Tensor& t, int axis, const std::string& index) {
+    int64_t stride = 1;
+    for (int d = axis + 1; d < t.type.getRank(); ++d)
+        stride *= t.type.getDimSize(d);
+    return "((" + index + "/" + std::to_string(stride) + ")%" +
+           std::to_string(t.type.getDimSize(axis)) + ")";
+}
+
+// All admission is structural, before constructing any MLX kernel. Never read
+// dynamic numerical arrays on the host, and never convert a failed dispatch into
+// an optimization miss. Explicit inputs remain graph edges across compile replay.
+class RegionEmitter {
+public:
+    RegionEmitter(const ValueMap& values, mlir::ModuleOp module, int64_t trips)
+        : values_(values), module_(module), trips_(trips) {}
+
+    std::optional<Tensor> input(mlir::Value value) {
+        auto existing = captures_.find(ToKey(value));
+        if (existing != captures_.end())
+            return existing->second;
+        auto it = values_.find(ToKey(value));
+        if (it == values_.end())
+            return std::nullopt;
+        auto tensor = Describe(value.getType(), "input" + std::to_string(inputs.size()));
+        if (!tensor || it->second.size() != tensor->size ||
+            it->second.dtype() != MlirTypeToMlxDtype(tensor->type.getElementType()))
+            return std::nullopt;
+        if (it->second.ndim() != tensor->type.getRank())
+            return std::nullopt;
+        for (int d = 0; d < tensor->type.getRank(); ++d)
+            if (it->second.shape(d) != tensor->type.getDimSize(d))
+                return std::nullopt;
+        tensor->strided = tensor->type.getRank() != 0;
+        // Read real strides in the device kernel: broadcasts/transposes are not
+        // secretly materialized just to make this optimization admissible.
+        inputs.push_back(tensor->strided ? it->second : mlx::core::reshape(it->second, {1}));
+        inputNames.push_back(tensor->name);
