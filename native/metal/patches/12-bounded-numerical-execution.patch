+            }
+            return each("(" + cast + "(" + a[0].at("e") + ")" + symbol + cast + "(" + a[1].at("e") +
+                        "))");
+        }
+        std::string symbol;
+        if (name == "stablehlo.add")
+            symbol = "+";
+        else if (name == "stablehlo.subtract")
+            symbol = "-";
+        else if (name == "stablehlo.multiply")
+            symbol = "*";
+        else if (name == "stablehlo.and")
+            symbol = "&";
+        else if (name == "stablehlo.or")
+            symbol = "|";
+        else if (name == "stablehlo.xor")
+            symbol = "^";
+        else
+            return false;
+        if (a.size() != 2)
+            return false;
+        bool floating = r.type.getElementType().isF32();
+        if (floating && (symbol == "&" || symbol == "|" || symbol == "^"))
+            return false;
+        if (r.type.getElementType().isInteger(1) &&
+            (symbol == "+" || symbol == "-" || symbol == "*"))
+            return false;
+        std::string left = a[0].at("e"), right = a[1].at("e");
+        // Unsigned intermediates make signed integer overflow modular, not UB.
+        if (!floating) {
+            left = "ulong(" + left + ")";
+            right = "ulong(" + right + ")";
+        }
+        return each(MetalType(r.type.getElementType()) + "(" + left + symbol + right + ")");
+    }
+
+    const ValueMap& values_;
+    mlir::ModuleOp module_;
+    int64_t trips_;
+    int64_t bytes_ = 0;
+    int64_t work_ = 0;
+    size_t operations_ = 0;
+    size_t next_ = 0;
+    Bindings captures_;
+    std::unordered_set<mlir::Operation*> activeCalls_;
+};
+}  // namespace
+
+std::optional<std::vector<mlx::core::array>> TryDeviceCountedRegion(mlir::stablehlo::WhileOp op,
+                                                                    size_t counterIndex,
+                                                                    int64_t trips,
+                                                                    const ValueMap& values,
+                                                                    mlir::ModuleOp module) {
+    if (trips < 0 || trips > kMaxTrips || !op.getBody().hasOneBlock() ||
+        !op.getCond().hasOneBlock() || op.getNumOperands() > 32)
+        return std::nullopt;
+    auto& body = op.getBody().front();
+    auto& cond = op.getCond().front();
+    auto* ret = body.getTerminator();
+    if (ret->getNumOperands() != op.getNumOperands())
+        return std::nullopt;
+    RegionEmitter emitter(values, module, trips);
+    Bindings bodyEnv, condEnv;
+    std::vector<Tensor> state;
+    std::vector<size_t> changed;
+    int64_t stateSize = 0;
+    for (size_t i = 0; i < op.getNumOperands(); ++i) {
+        auto initial = emitter.input(op->getOperand(i));
+        if (!initial)
+            return std::nullopt;
+        // Loop-invariant arrays remain device input pointers, not local copies.
+        bool invariant = ret->getOperand(i) == body.getArgument(i);
+        Tensor current = *initial;
+        if (!invariant) {
+            stateSize += initial->size;
+            if (stateSize > kMaxStateElements)
+                return std::nullopt;
+            auto local = emitter.temporary(initial->type);
+            if (!local)
+                return std::nullopt;
+            emitter.copy(*local, *initial);
+            current = *local;
+            changed.push_back(i);
+        }
+        state.push_back(current);
+        bodyEnv.emplace(ToKey(body.getArgument(i)), current);
+        condEnv.emplace(ToKey(cond.getArgument(i)), current);
+    }
+    if (counterIndex >= state.size() || changed.size() < 2)
+        return std::nullopt;
+    emitter.source << "for (uint iteration=0; iteration<" << trips << "; ++iteration) {\n";
+    // Validate and emit the whole condition too: unused callbacks/effects cannot
+    // hide behind a canonical compare or an apparently zero-trip loop.
+    auto conditions = emitter.block(cond, std::move(condEnv));
+    if (!conditions || conditions->size() != 1 || (*conditions)[0].size != 1)
+        return std::nullopt;
+    emitter.source << "if (!" << (*conditions)[0].at("0") << ") break;\n";
+    auto next = emitter.block(body, std::move(bodyEnv));
+    if (!next || next->size() != state.size())
+        return std::nullopt;
+    // Parallel assignment of loop-carried results. Body temporaries are distinct
+    // from current state, but a result can directly alias another carried state.
+    std::vector<Tensor> assignments;
+    for (size_t i : changed) {
+        const auto& value = (*next)[i];
+        bool aliasesOtherState = std::any_of(changed.begin(), changed.end(), [&](size_t j) {
+            return j != i && value.name == state[j].name;
+        });
+        if (aliasesOtherState) {
+            auto snapshot = emitter.temporary(state[i].type);
+            if (!snapshot)
+                return std::nullopt;
+            emitter.copy(*snapshot, value);
+            assignments.push_back(*snapshot);
+        } else
+            assignments.push_back(value);
+    }
+    for (size_t j = 0; j < changed.size(); ++j)
+        if (state[changed[j]].name != assignments[j].name)
+            emitter.copy(state[changed[j]], assignments[j]);
+    emitter.source << "}\n";
+    // One buffer per input/output plus at most one stride buffer per input.
+    // Refuse before dispatch if the conservative Metal argument budget is full.
+    if (2 * emitter.inputs.size() + changed.size() > 31)
+        return std::nullopt;
+    std::vector<std::string> names;
+    std::vector<mlx::core::Shape> shapes;
+    std::vector<mlx::core::Dtype> dtypes;
+    for (size_t j = 0; j < changed.size(); ++j) {
+        size_t i = changed[j];
+        std::string name = "output" + std::to_string(j);
+        names.push_back(name);
+        shapes.push_back({static_cast<int32_t>(state[i].size)});
+        dtypes.push_back(MlirTypeToMlxDtype(state[i].type.getElementType()));
+        emitter.source << "for (uint e=0; e<" << state[i].size << "; ++e) " << name
+                       << "[e]=" << state[i].at("e") << ";\n";
+    }
+    // MLX's safe-math default plus disabled FP contraction preserve explicit
+    // event/compensation operations. This is never a reduction reassociation.
+    std::string source = emitter.source.str();
+    std::string identity = source;
+    for (const auto& input : emitter.inputs)
+        identity += ":" + std::to_string(static_cast<int>(input.dtype().val()));
+    std::string kernelName =
+        "phydrax_bounded_ordered_region_" + std::to_string(std::hash<std::string>{}(identity));
+    auto kernel =
+        mlx::core::fast::metal_kernel(kernelName, emitter.inputNames, names, source,
+                                      "#pragma clang fp contract(off)\n", false, false, {});
+    auto output =
+        kernel(emitter.inputs, shapes, dtypes, {1, 1, 1}, {1, 1, 1}, {}, std::nullopt, false, {});
+    std::vector<mlx::core::array> results;
+    size_t j = 0;
+    for (size_t i = 0; i < state.size(); ++i) {
+        if (j < changed.size() && changed[j] == i) {
+            results.push_back(mlx::core::reshape(output[j++], GetShape(state[i].type)));
+        } else
+            results.push_back(values.at(ToKey(op->getOperand(i))));
+    }
+    MPS_LOG_DEBUG("device region: %lld trips, %zu carried outputs, %lld state elements\n",
+                  static_cast<long long>(trips), changed.size(), static_cast<long long>(stateSize));
+    return results;
+}
+}  // namespace jax_mps
