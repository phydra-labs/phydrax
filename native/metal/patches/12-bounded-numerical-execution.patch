+            if (auto call = mlir::dyn_cast<mlir::func::CallOp>(op)) {
+                auto fn = module_.lookupSymbol<mlir::func::FuncOp>(call.getCallee());
+                if (!fn || fn.isExternal() || !fn.getBody().hasOneBlock() ||
+                    fn.getNumArguments() != args.size() || activeCalls_.count(fn.getOperation()))
+                    return std::nullopt;
+                Bindings local = env;
+                for (size_t i = 0; i < args.size(); ++i)
+                    local.insert_or_assign(ToKey(fn.getArgument(i)), args[i]);
+                activeCalls_.insert(fn.getOperation());
+                auto results = this->block(fn.getBody().front(), std::move(local), depth + 1);
+                activeCalls_.erase(fn.getOperation());
