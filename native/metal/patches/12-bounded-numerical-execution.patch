+bool UvuDotDimensions(mlir::stablehlo::DotGeneralOp dot, const std::vector<int64_t>& lhsBatch,
+                      const std::vector<int64_t>& rhsBatch,
+                      std::initializer_list<int64_t> lhsContract,
+                      std::initializer_list<int64_t> rhsContract) {
+    auto dims = dot.getDotDimensionNumbers();
+    return dims.getLhsBatchingDimensions() == llvm::ArrayRef<int64_t>(lhsBatch) &&
+           dims.getRhsBatchingDimensions() == llvm::ArrayRef<int64_t>(rhsBatch) &&
+           dims.getLhsContractingDimensions() == llvm::ArrayRef<int64_t>(lhsContract) &&
+           dims.getRhsContractingDimensions() == llvm::ArrayRef<int64_t>(rhsContract) &&
+           !dot.getAlgorithm() &&
