+// Admit only custom_call targets with a GPU handler (or host callbacks and
+// sharding annotations). Checked on every function and nested region before
+// inlining or folding, so a target in an unselected or constant-dead branch is
+// refused too; there is no CPU numerical route (e.g. LAPACK eigh/qr/svd).
+std::string checkCustomCallTargets(mlir::ModuleOp module) {
+    std::string refusal;
+    module.walk([&](mlir::stablehlo::CustomCallOp call) {
+        auto target = call.getCallTargetName();
+        if (jax_mps::IsAdmittedCustomCallTarget({target.data(), target.size()}))
+            return mlir::WalkResult::advance();
+        refusal = "phydrax-metal: stablehlo.custom_call target '" + target.str() +
+                  "' is not supported; only Metal GPU custom calls and host callbacks are "
+                  "admitted, with no CPU numerical fallback";
+        return mlir::WalkResult::interrupt();
+    });
+    return refusal;
+}
