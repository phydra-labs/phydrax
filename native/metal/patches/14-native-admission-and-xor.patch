+// Custom-call targets HandleCustomCall executes on the GPU, plus host callbacks
+// and single-device sharding annotations. Parser admission refuses every other
+// target before execution, wherever it appears (including unselected branches),
+// so no target can reach a CPU numerical route such as LAPACK eigh/qr/svd.
+bool IsAdmittedCustomCallTarget(std::string_view target) {
+    static const std::unordered_set<std::string_view> kTargets = {
+        "Sharding",
+        "SPMDFullToShardShape",
+        "SPMDShardToFullShape",
+        "mhlo.topk",
+        "mps.sdpa",
+        "mps.sdpa_causal",
+        "mps.quantize",
+        "mps.dequantize",
+        "mps.quantized_matmul",
+        "mps.threefry2x32",
+        "mps.rms_norm",
+        "mps.addmm",
+        "mps.softmax",
+        "mps.layer_norm",
+        "mps.layer_norm_bwd",
+        "mps.rope",
+        "mps.gelu",
+        "mps.sdpa_bwd",
+        "mps.sdpa_causal_bwd",
+        "mps.rms_norm_bwd",
+        "mps.rope_bwd",
+        "mps.gelu_bwd",
+    };
+    if (target == kHostCallbackTarget || kTargets.count(target))
+        return true;
+    static constexpr std::string_view kMhloPrefix = "mhlo.";
+    return target.substr(0, kMhloPrefix.size()) == kMhloPrefix &&
+           UnaryMlxOps().count(target.substr(kMhloPrefix.size()));
+}
