diff --git a/src/pjrt_plugin/ops/host_callback.cc b/src/pjrt_plugin/ops/host_callback.cc
new file mode 100644
index 0000000000000000000000000000000000000000..85fba9c067495a171b2dcea9f68728e519ab73fc
--- /dev/null
+++ b/src/pjrt_plugin/ops/host_callback.cc
@@ -0,0 +1,262 @@
+// Host callbacks (jax.pure_callback, jax.experimental.io_callback,
+// jax.debug.callback/print, and therefore equinox.error_if) for phydrax-metal.
+//
+// The companion's Python registration lowers the callback primitives on the
+// "mps" platform to
+//
+//   stablehlo.custom_call @phydrax_metal.host_callback(token?, args...)
+//       {backend_config = "{\"callback_id\": N}", has_side_effect = ...}
+//
+// where N names a Python callable in the companion's process-local registry.
+// The registry holds only weak references; the strong reference is owned by
+// the JAX executable's host callbacks, so a callback lives exactly as long as
+// the executables that can invoke it. Callback ids are never serialized.
+//
+// Execution: a HostCallbackPrimitive on the CPU stream waits for producing GPU
+// work, hands contiguous host views of its operands to the installed
+// trampoline, and receives results in freshly allocated unified-memory
+// buffers. A Python exception becomes a C++ exception carrying its text, which
+// surfaces as the failing PJRT execution. Tokens are data dependencies only.
+// Side-effecting callbacks are recorded in ExecContext::side_effects so they
+// are evaluated even when no result is consumed.
+
+#include <mlx/allocator.h>
+#include <mlx/mlx.h>
+#include <mlx/primitives.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "llvm/Support/JSON.h"
+#include "pjrt_plugin/ops/handler_utils.h"
+#include "stablehlo/dialect/StablehloOps.h"
+#include "xla/pjrt/c/pjrt_c_api.h"
+
+extern "C" {
+
+// One host buffer handed across the trampoline: row-major, contiguous. The
+// memory belongs to the plugin for the duration of the call only.
+struct PhydraxMetalHostBuffer {
+    void* data;
+    int32_t element_type;  // PJRT_Buffer_Type
+    int32_t rank;
+    const int64_t* dims;
+};
+
+// Returns 0 on success. On failure writes a NUL-terminated message (at most
+// error_size bytes including the terminator) and returns nonzero. Must not
+// throw or unwind across this boundary.
+typedef int32_t (*PhydraxMetalHostCallbackTrampoline)(
+    uint64_t callback_id, int32_t num_inputs, const PhydraxMetalHostBuffer* inputs,
+    int32_t num_outputs, const PhydraxMetalHostBuffer* outputs, char* error,
+    int32_t error_size);
+
+// Installs the trampoline once per process. Re-installing the same function is
+// a no-op; installing a different one is refused (returns nonzero) so a second
+// loader cannot silently take over callbacks of live executables.
+__attribute__((visibility("default"))) int32_t PhydraxMetal_SetHostCallbackTrampoline(
+    PhydraxMetalHostCallbackTrampoline trampoline);
+
+}  // extern "C"
+
+namespace {
+
+std::atomic<PhydraxMetalHostCallbackTrampoline> g_trampoline{nullptr};
+
+constexpr int32_t kErrorSize = 1 << 16;
+
+}  // namespace
+
+int32_t PhydraxMetal_SetHostCallbackTrampoline(PhydraxMetalHostCallbackTrampoline trampoline) {
+    if (trampoline == nullptr)
+        return 1;
+    PhydraxMetalHostCallbackTrampoline expected = nullptr;
+    if (g_trampoline.compare_exchange_strong(expected, trampoline))
+        return 0;
+    return expected == trampoline ? 0 : 1;
+}
+
+namespace jax_mps {
+
+const char* const kHostCallbackTarget = "phydrax_metal.host_callback";
+
+namespace {
+
+class HostCallbackPrimitive : public mlx::core::Primitive {
+public:
+    HostCallbackPrimitive(mlx::core::Stream stream, uint64_t callbackId, size_t numTokens,
+                          std::vector<int32_t> resultTypes)
+        : Primitive(stream),
+          callbackId_(callbackId),
+          numTokens_(numTokens),
+          resultTypes_(std::move(resultTypes)) {}
+
+    void eval_cpu(const std::vector<mlx::core::array>& inputs,
+                  std::vector<mlx::core::array>& outputs) override {
+        eval_impl(inputs, outputs);
+    }
+
+    void eval_gpu(const std::vector<mlx::core::array>& inputs,
+                  std::vector<mlx::core::array>& outputs) override {
+        eval_impl(inputs, outputs);
+    }
+
+    const char* name() const override {
+        return "PhydraxHostCallback";
+    }
+
+    bool is_equivalent(const mlx::core::Primitive& other) const override {
+        return false;
+    }
+
+private:
+    void eval_impl(const std::vector<mlx::core::array>& inputs,
+                   std::vector<mlx::core::array>& outputs) {
+        // Operands may still be in flight on the GPU stream: an evaluated
+        // status only means their kernels were encoded.
+        mlx::core::synchronize(mlx::core::default_stream(mlx::core::Device::gpu));
+
+        PhydraxMetalHostCallbackTrampoline trampoline = g_trampoline.load();
+        if (trampoline == nullptr)
+            throw std::runtime_error(
+                "phydrax-metal: host callback invoked but the phydrax_metal loader did not "
+                "install its callback bridge");
+
+        std::vector<std::vector<int64_t>> dims;
+        dims.reserve(inputs.size() + outputs.size());
+        std::vector<PhydraxMetalHostBuffer> hostInputs;
+        for (size_t i = numTokens_; i < inputs.size(); ++i) {
+            const auto& in = inputs[i];
+            if (!in.flags().row_contiguous)
+                throw std::runtime_error("phydrax-metal: host callback operand is not contiguous");
+            dims.emplace_back(in.shape().begin(), in.shape().end());
+            hostInputs.push_back({const_cast<void*>(static_cast<const void*>(in.data<char>())),
+                                  MlxDtypeToPjrt(in.dtype()),
+                                  static_cast<int32_t>(in.ndim()), dims.back().data()});
+        }
+
+        // outputs[0] is the effect marker; outputs[1..] are callback results.
+        outputs[0].set_data(mlx::core::allocator::malloc(outputs[0].nbytes()));
+        std::memset(outputs[0].data<char>(), 0, outputs[0].nbytes());
+        std::vector<PhydraxMetalHostBuffer> hostOutputs;
+        for (size_t i = 1; i < outputs.size(); ++i) {
+            auto& out = outputs[i];
+            out.set_data(mlx::core::allocator::malloc(out.nbytes()));
+            dims.emplace_back(out.shape().begin(), out.shape().end());
+            hostOutputs.push_back({out.data<char>(), resultTypes_[i - 1],
+                                   static_cast<int32_t>(out.ndim()), dims.back().data()});
+        }
+
+        std::string error(kErrorSize, '\0');
+        int32_t status = trampoline(callbackId_, static_cast<int32_t>(hostInputs.size()),
+                                    hostInputs.data(), static_cast<int32_t>(hostOutputs.size()),
+                                    hostOutputs.data(), error.data(), kErrorSize);
+        if (status != 0) {
+            error.resize(std::strlen(error.c_str()));
+            throw std::runtime_error("phydrax-metal: host callback failed: " + error);
+        }
+    }
+
+    uint64_t callbackId_;
+    size_t numTokens_;
+    std::vector<int32_t> resultTypes_;
+};
+
+}  // namespace
+
+bool IsHostCallback(mlir::Operation* op) {
+    auto call = mlir::dyn_cast<mlir::stablehlo::CustomCallOp>(op);
+    return call && call.getCallTargetName() == kHostCallbackTarget;
+}
+
+bool RegionHasHostEffects(mlir::Region& region) {
+    bool found = false;
+    region.walk([&](mlir::stablehlo::CustomCallOp call) {
+        if (call.getCallTargetName() == kHostCallbackTarget && call.getHasSideEffect()) {
+            found = true;
+            return mlir::WalkResult::interrupt();
+        }
+        return mlir::WalkResult::advance();
+    });
+    return found;
+}
+
+bool HandleHostCallback(mlir::Operation* op, ValueMap& values, ExecContext& ctx) {
+    auto call = mlir::cast<mlir::stablehlo::CustomCallOp>(op);
+
+    std::optional<uint64_t> callbackId;
+    if (auto config = op->getAttrOfType<mlir::StringAttr>("backend_config")) {
+        if (auto parsed = llvm::json::parse(config.getValue())) {
+            if (auto* object = parsed->getAsObject()) {
+                if (auto id = object->getInteger("callback_id"); id && *id > 0)
+                    callbackId = static_cast<uint64_t>(*id);
+            }
+        } else {
+            llvm::consumeError(parsed.takeError());
+        }
+    }
+    if (!callbackId) {
+        ctx.error_message = "phydrax-metal: host callback without a valid callback_id";
+        return false;
+    }
+
+    // Leading token operands order this call after earlier ordered effects.
+    std::vector<mlx::core::array> inputs;
+    size_t numTokens = 0;
+    for (mlir::Value operand : op->getOperands()) {
+        auto* value = RequireValue(values, operand, kHostCallbackTarget);
+        if (!value)
+            return false;
+        if (mlir::isa<mlir::stablehlo::TokenType>(operand.getType())) {
+            if (numTokens != inputs.size()) {
+                ctx.error_message = "phydrax-metal: host callback tokens must precede operands";
+                return false;
+            }
+            ++numTokens;
+            inputs.push_back(*value);
+        } else {
+            inputs.push_back(mlx::core::contiguous(*value));
+        }
+    }
+
+    std::vector<mlx::core::Shape> shapes{{}};
+    std::vector<mlx::core::Dtype> dtypes{mlx::core::bool_};
+    std::vector<int32_t> resultTypes;
+    for (mlir::Type type : op->getResultTypes()) {
+        if (mlir::isa<mlir::stablehlo::TokenType>(type))
+            continue;
+        auto tensor = mlir::dyn_cast<mlir::RankedTensorType>(type);
+        if (!tensor) {
+            ctx.error_message = "phydrax-metal: host callback results must be ranked tensors";
+            return false;
+        }
+        auto dtype = MlirTypeToMlxDtype(tensor.getElementType());
+        shapes.push_back(GetShape(tensor));
+        dtypes.push_back(dtype);
+        resultTypes.push_back(MlxDtypeToPjrt(dtype));
+    }
+
+    auto primitive = std::make_shared<HostCallbackPrimitive>(
+        mlx::core::default_stream(mlx::core::Device::cpu), *callbackId, numTokens,
+        std::move(resultTypes));
+    auto arrays = mlx::core::array::make_arrays(std::move(shapes), dtypes, primitive, inputs);
+
+    size_t next = 1;
+    for (mlir::OpResult result : op->getResults()) {
+        if (mlir::isa<mlir::stablehlo::TokenType>(result.getType())) {
+            values.emplace(ToKey(result), arrays[0]);
+        } else {
+            values.emplace(ToKey(result), arrays[next++]);
+        }
+    }
+    if (call.getHasSideEffect())
+        ctx.side_effects.push_back(arrays[0]);
+    return true;
+}
+
+}  // namespace jax_mps
