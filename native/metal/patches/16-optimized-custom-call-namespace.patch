+static constexpr std::string_view kMhloTargetPrefix = "mhlo.";
+static constexpr std::string_view kPublishedTargetPrefix = "mps.";
+
+std::string_view CanonicalCustomCallTarget(std::string_view target) {
+    if (target.substr(0, kPublishedTargetPrefix.size()) != kPublishedTargetPrefix)
+        return target;
+    std::string_view canonical = target.substr(kPublishedTargetPrefix.size());
+    if (canonical.substr(0, kMhloTargetPrefix.size()) != kMhloTargetPrefix)
+        return target;
+    return canonical;
+}
+
+std::string PublishedCustomCallTarget(std::string_view target) {
+    if (target.substr(0, kMhloTargetPrefix.size()) == kMhloTargetPrefix &&
+        IsAdmittedCustomCallTarget(target)) {
+        std::string published(kPublishedTargetPrefix);
+        published += target;
+        return published;
+    }
+    return std::string(target);
+}
