+// Name of an element type Metal cannot represent exactly, or nullopt when the
+// type is supported (f32/f16/bf16, complex<f32>, 1/8/16/32/64-bit integers,
+// tokens). Metal has no 64-bit floating point, so float64/complex128 are
+// refused rather than narrowed.
+std::optional<std::string> unsupportedElementType(mlir::Type type) {
+    if (auto tuple = mlir::dyn_cast<mlir::TupleType>(type)) {
+        for (mlir::Type element : tuple.getTypes()) {
+            if (auto name = unsupportedElementType(element))
+                return name;
+        }
+        return std::nullopt;
+    }
+    if (auto shaped = mlir::dyn_cast<mlir::ShapedType>(type))
+        type = shaped.getElementType();
+    if (mlir::isa<mlir::stablehlo::TokenType>(type))
+        return std::nullopt;
+    if (type.isF32() || type.isF16() || type.isBF16())
+        return std::nullopt;
+    if (type.isF64())
+        return "float64";
+    if (auto complex = mlir::dyn_cast<mlir::ComplexType>(type)) {
+        if (complex.getElementType().isF32())
+            return std::nullopt;
+        if (complex.getElementType().isF64())
+            return "complex128";
+    }
+    if (auto integer = mlir::dyn_cast<mlir::IntegerType>(type)) {
+        switch (integer.getWidth()) {
+            case 1:
+            case 8:
+            case 16:
+            case 32:
+            case 64:
+                return std::nullopt;
+            default:
+                break;
+        }
+    }
+    std::string name;
+    llvm::raw_string_ostream os(name);
+    type.print(os);
+    return name;
+}
+
+// Refuse a program if any input, constant, intermediate or result has an
+// unsupported element type. Runs before any transformation so the message names
+// the operation JAX emitted.
+std::string checkElementTypes(mlir::ModuleOp module) {
+    std::string refusal;
+    auto refuse = [&](mlir::Operation* op, mlir::Type type, const std::string& name,
+                      const char* role) {
+        std::string typeText;
+        llvm::raw_string_ostream os(typeText);
+        type.print(os);
+        refusal = "phydrax-metal: " + name + " is not supported (" +
+                  op->getName().getStringRef().str() + " " + role + " " + typeText +
+                  "); Metal programs must use float32/complex64";
+    };
+    module.walk([&](mlir::Operation* op) {
+        for (mlir::Type type : op->getResultTypes()) {
+            if (auto name = unsupportedElementType(type)) {
+                refuse(op, type, *name, "result");
+                return mlir::WalkResult::interrupt();
+            }
+        }
+        for (mlir::Region& region : op->getRegions()) {
+            for (mlir::Block& block : region) {
+                for (mlir::BlockArgument argument : block.getArguments()) {
+                    if (auto name = unsupportedElementType(argument.getType())) {
+                        refuse(op, argument.getType(), *name, "argument");
+                        return mlir::WalkResult::interrupt();
+                    }
+                }
+            }
+        }
+        if (auto func = mlir::dyn_cast<mlir::func::FuncOp>(op)) {
+            for (mlir::Type type : func.getFunctionType().getResults()) {
+                if (auto name = unsupportedElementType(type)) {
+                    refuse(op, type, *name, "result");
+                    return mlir::WalkResult::interrupt();
+                }
+            }
+        }
+        return mlir::WalkResult::advance();
+    });
+    return refusal;
+}
