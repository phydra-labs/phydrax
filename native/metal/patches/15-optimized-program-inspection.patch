+// Returns the finalized module the executable walks as MLIR assembly ("mlir"),
+// which XLA's PjRtCApiExecutable::GetHloModule converts to an HloModule. A pure
+// query: it neither compiles, executes, nor runs host callbacks. The text is
+// printed once and cached on the executable, so the two-call protocol (size
+// query with code == nullptr, then fill) always agrees.
 PJRT_Error* MPS_Executable_OptimizedProgram(PJRT_Executable_OptimizedProgram_Args* args) {
-    return MakeError("OptimizedProgram not implemented", PJRT_Error_Code_UNIMPLEMENTED);
+    if (!args || args->struct_size < PJRT_Executable_OptimizedProgram_Args_STRUCT_SIZE) {
+        return MakeError("OptimizedProgram: missing or undersized argument struct",
+                         PJRT_Error_Code_INVALID_ARGUMENT);
+    }
+    if (!args->executable) {
+        return MakeError("Null executable", PJRT_Error_Code_INVALID_ARGUMENT);
+    }
+    PJRT_Program* program = args->program;
+    if (!program || program->struct_size < PJRT_Program_STRUCT_SIZE) {
+        return MakeError("OptimizedProgram: missing or undersized program struct",
+                         PJRT_Error_Code_INVALID_ARGUMENT);
+    }
+    PJRT_Executable* executable = args->executable;
+    std::scoped_lock cache_lock(executable->optimized_program_mutex);
+    if (!executable->optimized_program) {
+        std::scoped_lock lock(GetPjrtGlobalMutex());
+        if (!executable->executable) {
+            return MakeError("OptimizedProgram: executable has no compiled module",
+                             PJRT_Error_Code_FAILED_PRECONDITION);
+        }
+        try {
+            std::string text = executable->executable->OptimizedProgramText();
+            if (text.empty()) {
+                return MakeError("OptimizedProgram: executable has no compiled module",
+                                 PJRT_Error_Code_FAILED_PRECONDITION);
+            }
+            executable->optimized_program = std::move(text);
+        } catch (const std::exception& e) {
+            return MakeError(std::string("OptimizedProgram: ") + e.what());
+        }
+    }
+    const std::string& code = *executable->optimized_program;
+    // PjRtCApiExecutable::GetHloModule CHECK-fails (aborting the process) on a
+    // program of 2 GiB or more; report it as an error instead.
+    constexpr size_t kMaxProgramBytes = size_t{2} * 1024 * 1024 * 1024;
+    if (code.size() >= kMaxProgramBytes) {
+        return MakeError("OptimizedProgram: the " + std::to_string(code.size()) +
+                             "-byte program exceeds the 2 GiB PJRT program limit",
+                         PJRT_Error_Code_RESOURCE_EXHAUSTED);
+    }
+    static constexpr char kFormat[] = "mlir";
+    program->format = kFormat;
+    program->format_size = sizeof(kFormat) - 1;
+    if (!program->code) {
+        program->code_size = code.size();
+        return nullptr;
+    }
+    if (program->code_size < code.size()) {
+        return MakeError("OptimizedProgram: caller buffer of " +
+                             std::to_string(program->code_size) + " bytes is smaller than the " +
+                             std::to_string(code.size()) + "-byte program",
+                         PJRT_Error_Code_INVALID_ARGUMENT);
+    }
+    std::memcpy(program->code, code.data(), code.size());
+    program->code_size = code.size();
+    return nullptr;
 }
 
