+std::string printOptimizedProgram(mlir::ModuleOp module) {
+    std::string text;
+    if (!module) {
+        return text;
+    }
+    bool constrained = false;
+    module.walk([&](mlir::sdy::ShardingConstraintOp) {
+        constrained = true;
+        return mlir::WalkResult::interrupt();
+    });
+    llvm::raw_string_ostream os(text);
+    if (!constrained) {
+        module.print(os);
+        return text;
+    }
+    // checkSingleDevice admitted only single-device meshes, where a sharding
+    // constraint is the identity that HandleShardingConstraint executes. Spell
+    // it on a clone so the executed module stays untouched.
+    mlir::OwningOpRef<mlir::ModuleOp> program(module.clone());
+    program->walk([](mlir::sdy::ShardingConstraintOp constraint) {
+        mlir::OpBuilder builder(constraint);
+        mlir::Value input = constraint.getInput();
+        mlir::Type type = constraint.getResult().getType();
+        mlir::NamedAttribute attributes[] = {
+            builder.getNamedAttr("call_target_name", builder.getStringAttr("Sharding")),
+            builder.getNamedAttr("mhlo.sharding", builder.getStringAttr("{replicated}"))};
+        auto sharding = builder.create<mlir::stablehlo::CustomCallOp>(
+            constraint.getLoc(), mlir::TypeRange(type), mlir::ValueRange(input), attributes);
+        constraint.getResult().replaceAllUsesWith(sharding->getResult(0));
+        constraint.erase();
+    });
+    program->print(os);
+    return text;
+}
