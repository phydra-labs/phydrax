+// Solve M X = B on the GPU by forward (lower) or backward (upper) substitution,
+// reading only the selected triangle of M. Row i is
+//   x_i = (b_i - M[i, solved] @ X[solved]) / M[i, i]
+// with IEEE division (a zero pivot yields inf/nan, which callers' nonfinite
+// checks observe), and no division when the diagonal is implicitly one.
+mlx::core::array SubstitutionSolve(const mlx::core::array& m, const mlx::core::array& b,
+                                   bool lower, bool unitDiagonal) {
+    const int n = m.shape(-1);
+    const int k = b.shape(-1);
+    std::vector<mlx::core::array> rows;
+    rows.reserve(n);
+    std::optional<mlx::core::array> solved;  // rows solved so far, in solve order
+    for (int step = 0; step < n; ++step) {
+        const int i = lower ? step : n - 1 - step;
+        auto row = SliceMatrix(b, i, i + 1, 0, k);
+        if (solved) {
+            auto coefficients = lower ? SliceMatrix(m, i, i + 1, 0, i)
+                                      : SliceMatrix(m, i, i + 1, i + 1, n);
+            row = mlx::core::subtract(row, mlx::core::matmul(coefficients, *solved));
+        }
+        if (!unitDiagonal)
+            row = mlx::core::divide(row, SliceMatrix(m, i, i + 1, i, i + 1));
+        rows.push_back(row);
+        if (!solved)
+            solved = row;
+        else
+            solved = lower ? mlx::core::concatenate({*solved, row}, -2)
+                           : mlx::core::concatenate({row, *solved}, -2);
+    }
+    if (!solved)
+        return b;
+    return *solved;
 }
 
