+// Slice rows [r0, r1) and columns [c0, c1) of the trailing matrix dimensions.
+mlx::core::array SliceMatrix(const mlx::core::array& a, int r0, int r1, int c0, int c1) {
+    const int rank = static_cast<int>(a.ndim());
+    mlx::core::Shape start(rank, 0);
+    mlx::core::Shape stop = a.shape();
+    start[rank - 2] = r0;
+    stop[rank - 2] = r1;
+    start[rank - 1] = c0;
+    stop[rank - 1] = c1;
+    return mlx::core::slice(a, start, stop);
+}
 
