+// Used before constructing any MLX array or staging allocation.
+size_t CheckedByteSize(const std::vector<int64_t>& dims, size_t element_size,
+                       bool check_device_limit) {
+    bool empty = false;
+    for (int64_t dim : dims) {
+        if (dim < 0 || dim > std::numeric_limits<int>::max())
+            throw std::invalid_argument("phydrax-metal: unsupported buffer dimension " +
+                                        std::to_string(dim));
+        empty = empty || dim == 0;
+    }
+    size_t bytes = empty ? 0 : element_size;
+    for (int64_t dim : dims) {
+        if (__builtin_mul_overflow(bytes, static_cast<size_t>(dim), &bytes))
+            throw std::invalid_argument("phydrax-metal: buffer shape byte size overflows");
+    }
+    if (bytes > static_cast<size_t>(std::numeric_limits<std::ptrdiff_t>::max()))
+        throw std::invalid_argument("phydrax-metal: buffer byte size exceeds pointer range");
+    if (check_device_limit) {
+        size_t limit = mlx::core::get_memory_limit();
+        const auto& info = mlx::core::gpu::device_info(0);
+        if (auto it = info.find("max_buffer_length"); it != info.end()) {
+            if (const auto* max_buffer = std::get_if<size_t>(&it->second))
+                limit = std::min(limit, *max_buffer);
+        }
+        if (bytes > limit)
+            throw std::invalid_argument("phydrax-metal: host transfer needs " +
+                std::to_string(bytes) + " bytes, above the Metal allocation limit of " +
+                std::to_string(limit) + " bytes; not allocated");
+    }
+    return bytes;
+}
+
+void CheckStridedOffsets(const std::vector<int64_t>& dims,
+                         const std::vector<int64_t>& strides, size_t element_size) {
+    if (strides.empty()) return;
+    if (strides.size() != dims.size())
+        throw std::invalid_argument("phydrax-metal: host stride rank does not match shape");
+    if (std::find(dims.begin(), dims.end(), 0) != dims.end()) return;
+    std::ptrdiff_t low = 0, high = 0;
+    for (size_t i = 0; i < dims.size(); ++i) {
+        std::ptrdiff_t extent;
+        if (__builtin_mul_overflow(static_cast<std::ptrdiff_t>(dims[i] - 1),
+                                   strides[i], &extent) ||
+            (extent < 0 ? __builtin_add_overflow(low, extent, &low)
+                        : __builtin_add_overflow(high, extent, &high)))
+            throw std::invalid_argument("phydrax-metal: host stride offset overflows");
+    }
+    if (high > std::numeric_limits<std::ptrdiff_t>::max() -
+                   static_cast<std::ptrdiff_t>(element_size - 1))
+        throw std::invalid_argument("phydrax-metal: host stride byte range overflows");
+}
