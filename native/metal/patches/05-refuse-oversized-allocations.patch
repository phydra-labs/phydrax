+// Byte size of one element of a supported type (0 for tokens).
+uint64_t elementBytes(mlir::Type type) {
+    if (mlir::isa<mlir::stablehlo::TokenType>(type))
+        return 0;
+    if (auto complex = mlir::dyn_cast<mlir::ComplexType>(type))
+        return 2 * elementBytes(complex.getElementType());
+    const unsigned bits = type.getIntOrFloatBitWidth();
+    return bits <= 8 ? 1 : bits / 8;
+}
+
+// Refuse a program if any statically shaped value (input, constant,
+// intermediate, result) needs more bytes than one Metal buffer may hold or than
+// the MLX allocator's actual memory limit, or has a dimension MLX cannot index
+// (int32 shapes). Sizes use checked multiplication; nothing is truncated, and
+// the check runs before constant folding or any MLX array exists.
+std::string checkAllocationSizes(mlir::ModuleOp module) {
+    uint64_t limit = mlx::core::get_memory_limit();
+    const auto& info = mlx::core::gpu::device_info(0);
+    if (auto it = info.find("max_buffer_length"); it != info.end()) {
+        if (const auto* maxBuffer = std::get_if<size_t>(&it->second))
+            limit = std::min<uint64_t>(limit, *maxBuffer);
+    }
+    std::string refusal;
+    auto check = [&](mlir::Operation* op, mlir::Type type) {
+        auto shaped = mlir::dyn_cast<mlir::RankedTensorType>(type);
+        if (!shaped)
+            return true;
+        uint64_t bytes = elementBytes(shaped.getElementType());
+        bool overflow = false;
+        for (int64_t dim : shaped.getShape()) {
+            if (mlir::ShapedType::isDynamic(dim) || dim < 0 ||
+                dim > std::numeric_limits<int32_t>::max()) {
+                refusal = "phydrax-metal: dimension " + std::to_string(dim) + " of " +
+                          op->getName().getStringRef().str() + " is not supported";
+                return false;
+            }
+            overflow = overflow || __builtin_mul_overflow(bytes, static_cast<uint64_t>(dim), &bytes);
+        }
+        if (overflow || bytes > limit) {
+            std::string typeText;
+            llvm::raw_string_ostream os(typeText);
+            type.print(os);
+            refusal = "phydrax-metal: " + op->getName().getStringRef().str() + " value " +
+                      typeText + " needs " + (overflow ? std::string("more than 2^64") :
+                                              std::to_string(bytes)) +
+                      " bytes, above the Metal allocation limit of " + std::to_string(limit) +
+                      " bytes; not executed";
+            return false;
+        }
+        return true;
+    };
+    module.walk([&](mlir::Operation* op) {
+        for (mlir::Type type : op->getResultTypes()) {
+            if (!check(op, type))
+                return mlir::WalkResult::interrupt();
+        }
+        for (mlir::Region& region : op->getRegions()) {
+            for (mlir::Block& block : region) {
+                for (mlir::BlockArgument argument : block.getArguments()) {
+                    if (!check(op, argument.getType()))
+                        return mlir::WalkResult::interrupt();
+                }
+            }
+        }
+        return mlir::WalkResult::advance();
+    });
+    return refusal;
+}
