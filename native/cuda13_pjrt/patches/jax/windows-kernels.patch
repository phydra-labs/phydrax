+    MaybePerturbPivot(CopySign(perturb, real(p)), p, rhs_row);
     x.row(n - 2) = rhs_row * (Scalar(1.0) / p);
   }
 
   for (int k = n - 3; k >= 0; --k) {
     p = u(k, 0);
