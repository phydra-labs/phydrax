 namespace jax {
 
+// winjax: MSVC's ucrt declares the float C++ overload of copysign as a
+// host-only `static __inline` function, which the clang CUDA device pass
+// cannot emit code for (ptxas: unresolved '_ZL8copysignff'). Route through
+// the C99 functions, which have __device__ overloads in clang's CUDA math
+// wrappers.
+#ifdef _WIN32
+EIGEN_DEVICE_FUNC inline float CopySign(float a, float b) {
+  return ::copysignf(a, b);
+}
+EIGEN_DEVICE_FUNC inline double CopySign(double a, double b) {
+  return ::copysign(a, b);
+}
+#else
+template <typename T>
+EIGEN_DEVICE_FUNC inline T CopySign(T a, T b) {
+  return std::copysign(a, b);
+}
+#endif
+
