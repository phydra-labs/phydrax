diff --git a/jaxlib/tridiagonal_solve_perturbed.h b/jaxlib/tridiagonal_solve_perturbed.h
--- a/jaxlib/tridiagonal_solve_perturbed.h
+++ b/jaxlib/tridiagonal_solve_perturbed.h
