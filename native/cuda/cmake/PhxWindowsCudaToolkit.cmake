# Explicit Windows toolchain and RECORD-owned CUDA view; no global toolkit search.
foreach(variable IN ITEMS PHX_WINDOWS_CC PHX_WINDOWS_CXX PHX_WINDOWS_CUDA_HOST_COMPILER
    PHX_WINDOWS_NVCC PHX_WINDOWS_LIB PHX_WINDOWS_MSVC_ROOT PHX_WINDOWS_SDK_ROOT
    PHX_WINDOWS_SDK_VERSION PHX_PATCH_EXECUTABLE PHX_WINDOWS_CMAKE PHX_WINDOWS_NINJA)
  if(NOT DEFINED ${variable})
    set(${variable} "$ENV{${variable}}" CACHE STRING "Explicit Windows CUDA build input")
  endif()
  if("${${variable}}" STREQUAL "")
    message(FATAL_ERROR "${variable} is required for a Windows CUDA build")
  endif()
  if(NOT variable STREQUAL "PHX_WINDOWS_SDK_VERSION")
    if(NOT IS_ABSOLUTE "${${variable}}" OR NOT EXISTS "${${variable}}")
      message(FATAL_ERROR "${variable} must name an existing absolute path: ${${variable}}")
    endif()
    file(TO_CMAKE_PATH "${${variable}}" ${variable})
  endif()
  set(ENV{${variable}} "${${variable}}")
endforeach()
get_filename_component(_phx_host_name "${PHX_WINDOWS_CUDA_HOST_COMPILER}" NAME)
get_filename_component(_phx_cxx_name "${PHX_WINDOWS_CXX}" NAME)
if(NOT _phx_host_name STREQUAL "cl.exe" OR NOT _phx_cxx_name STREQUAL "clang-cl.exe")
  message(FATAL_ERROR "Windows CUDA requires clang-cl.exe for host FFI and cl.exe for nvcc host compilation")
endif()
set(_phx_sdk_include "${PHX_WINDOWS_SDK_ROOT}/Include/${PHX_WINDOWS_SDK_VERSION}")
set(_phx_sdk_lib "${PHX_WINDOWS_SDK_ROOT}/Lib/${PHX_WINDOWS_SDK_VERSION}")
set(_phx_sdk_bin "${PHX_WINDOWS_SDK_ROOT}/bin/${PHX_WINDOWS_SDK_VERSION}/x64")
set(_phx_include "${PHX_WINDOWS_MSVC_ROOT}/include;${_phx_sdk_include}/ucrt;${_phx_sdk_include}/shared;${_phx_sdk_include}/um;${_phx_sdk_include}/winrt")
set(_phx_lib "${PHX_WINDOWS_MSVC_ROOT}/lib/x64;${_phx_sdk_lib}/ucrt/x64;${_phx_sdk_lib}/um/x64")
foreach(path IN LISTS _phx_include _phx_lib)
  if(NOT IS_DIRECTORY "${path}")
    message(FATAL_ERROR "Missing explicit MSVC/SDK build input: ${path}")
  endif()
endforeach()
foreach(tool IN ITEMS rc mt)
  if(NOT EXISTS "${_phx_sdk_bin}/${tool}.exe")
    message(FATAL_ERROR "Missing explicit SDK tool: ${_phx_sdk_bin}/${tool}.exe")
  endif()
endforeach()
set(ENV{INCLUDE} "${_phx_include}")
set(ENV{LIB} "${_phx_lib}")
get_filename_component(_phx_cl_bin "${PHX_WINDOWS_CUDA_HOST_COMPILER}" DIRECTORY)
get_filename_component(_phx_llvm_bin "${PHX_WINDOWS_CXX}" DIRECTORY)
set(ENV{PATH} "${_phx_llvm_bin};${_phx_cl_bin};${_phx_sdk_bin};$ENV{PATH}")
if(NOT CMAKE_GENERATOR STREQUAL "Ninja")
  message(FATAL_ERROR "Windows CUDA builds require the explicit Ninja generator")
endif()
file(REAL_PATH "${CMAKE_COMMAND}" _phx_running_cmake)
file(REAL_PATH "${PHX_WINDOWS_CMAKE}" _phx_requested_cmake)
string(TOLOWER "${_phx_running_cmake}" _phx_running_cmake)
string(TOLOWER "${_phx_requested_cmake}" _phx_requested_cmake)
if(NOT _phx_running_cmake STREQUAL _phx_requested_cmake)
  message(FATAL_ERROR "Running CMake differs from PHX_WINDOWS_CMAKE")
endif()
set(CMAKE_MAKE_PROGRAM "${PHX_WINDOWS_NINJA}" CACHE FILEPATH "Explicit Ninja build tool" FORCE)
set(CMAKE_C_COMPILER "${PHX_WINDOWS_CC}" CACHE FILEPATH "Explicit host C compiler" FORCE)
set(CMAKE_CXX_COMPILER "${PHX_WINDOWS_CXX}" CACHE FILEPATH "Explicit host FFI C++ compiler" FORCE)
set(CMAKE_CUDA_HOST_COMPILER "${PHX_WINDOWS_CUDA_HOST_COMPILER}" CACHE FILEPATH "Supported nvcc MSVC host" FORCE)
# The copied MSVC/SDK inputs have an explicit environment above, not a Visual
# Studio installation with vcvars batch files. This does not disable nvcc's
# compiler-version or target checks.
string(APPEND CMAKE_CUDA_FLAGS_INIT " --use-local-env")
set(CMAKE_RC_COMPILER "${_phx_sdk_bin}/rc.exe" CACHE FILEPATH "Explicit SDK resource compiler" FORCE)
set(CMAKE_MT "${_phx_sdk_bin}/mt.exe" CACHE FILEPATH "Explicit SDK manifest tool" FORCE)
# Serialize shared download preparation; the view itself belongs to this build.
file(LOCK "${PHX_CUDA_DOWNLOAD_DIR}/windows-toolkit.lock" GUARD FILE TIMEOUT 600)
execute_process(COMMAND "${Python_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/windows_toolkit.py"
  "${PHX_CUDA_TOOLKIT}" "${PHX_CUDA_DOWNLOAD_DIR}" "${PHX_CUDA_COMPONENTS}"
  COMMAND_ERROR_IS_FATAL ANY)
file(READ "${PHX_CUDA_TOOLKIT}/discovery.json" _phx_windows_discovery)
string(JSON PHX_CUDA_TOOLCHAIN_PINS GET "${_phx_windows_discovery}" upstream_pins)
foreach(component IN ITEMS cudss cutensor)
  if(component IN_LIST PHX_CUDA_COMPONENTS)
    string(JSON _phx_dll GET "${_phx_windows_discovery}" component_dlls "${component}")
    string(TOUPPER "${component}" upper)
    set(PHX_WINDOWS_${upper}_DLL "${_phx_dll}")
  endif()
endforeach()
set(PHX_CUDA_RUNPATH "")
set(CUDAToolkit_ROOT "${PHX_CUDA_TOOLKIT}" CACHE PATH "RECORD-owned CUDA toolkit" FORCE)
set(CMAKE_CUDA_COMPILER "${PHX_CUDA_TOOLKIT}/bin/nvcc.exe" CACHE FILEPATH "RECORD-owned nvcc" FORCE)
execute_process(COMMAND "${CMAKE_CUDA_COMPILER}" --version
  OUTPUT_VARIABLE _phx_nvcc_version COMMAND_ERROR_IS_FATAL ANY)
if(NOT _phx_nvcc_version MATCHES "release 13\\.")
  message(FATAL_ERROR "Expected CUDA 13 nvcc: ${_phx_nvcc_version}")
endif()
