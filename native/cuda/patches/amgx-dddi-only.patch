# Phydrax companion specialization: only the public dDDI mode is exposed.
# Keep hDDI and integer double-matrix vectors internally for host/device copies
# and classical AMG graph operations. Do not remove algorithms or solver types.
# This cuts unused float/mixed/complex instantiations, not numerical precision.
# Qualified by the same aggregation/classical, refresh, multi-RHS GPU tests.
diff --git a/include/amgx_config.h b/include/amgx_config.h
--- a/include/amgx_config.h
+++ b/include/amgx_config.h
@@ -124,5 +124,19 @@ typedef enum
 } AMGX_Mode;
 
+#ifdef PHX_AMGX_DDDI_ONLY
+#define AMGX_FORALL_BUILDS_HOST(codeLineMacro) codeLineMacro(AMGX_mode_hDDI)
+#define AMGX_FORINTVEC_BUILDS_HOST(codeLineMacro) codeLineMacro(AMGX_mode_hIDI)
+#define AMGX_FORALL_BUILDS_DEVICE(codeLineMacro) codeLineMacro(AMGX_mode_dDDI)
+#define AMGX_FORINTVEC_BUILDS_DEVICE(codeLineMacro) codeLineMacro(AMGX_mode_dIDI)
+#define AMGX_FORCOMPLEX_BUILDS_DEVICE(codeLineMacro)
+#define AMGX_FORCOMPLEX_BUILDS_HOST(codeLineMacro)
+#define AMGX_FORALL_BUILDS(codeLineMacro) \
+  AMGX_FORALL_BUILDS_HOST(codeLineMacro) AMGX_FORALL_BUILDS_DEVICE(codeLineMacro)
+#define AMGX_FORCOMPLEX_BUILDS(codeLineMacro)
+#define AMGX_FORINTVEC_BUILDS(codeLineMacro) \
+  AMGX_FORINTVEC_BUILDS_HOST(codeLineMacro) AMGX_FORINTVEC_BUILDS_DEVICE(codeLineMacro)
+#else
+
 /* Builds for host */
 #ifdef AMGX_build_host
 #define AMGX_FORALL_BUILDS_HOST(codeLineMacro)\
@@ -175,6 +189,7 @@ typedef enum
 #define AMGX_FORINTVEC_BUILDS(codeLineMacro)\
   AMGX_FORINTVEC_BUILDS_HOST(codeLineMacro)\
   AMGX_FORINTVEC_BUILDS_DEVICE(codeLineMacro)
