+    // elect.sync is available in PTX 8.0, but CUDA 12 CCCL has no C++
+    // wrapper. Keep its converged-warp semantics on both toolkit majors.
+#ifdef QUDA_CUDA_CC
+    __device__ inline bool elect_one_lane()
+    {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 900
+      unsigned int elected;
+      asm volatile("{ .reg .pred p; elect.sync _|p, %1; selp.b32 %0, 1, 0, p; }"
+                   : "=r"(elected) : "r"(0xFFFFFFFFu));
+      return elected != 0;
+#else
+      const auto lane = thread_idx_linear<3>() % 32;
+      return lane == static_cast<unsigned int>(__ffs(__activemask()) - 1);
+#endif
+    }
+#endif
