+namespace quda::host {
+#ifdef _WIN32
+  inline std::wstring utf16(const std::string &text)
+  {
+    if (text.empty()) return {};
+    int length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text.c_str(), -1, nullptr, 0);
+    if (!length) throw std::system_error(GetLastError(), std::system_category(), "QUDA UTF-8 path conversion");
+    std::wstring result(length, L'\0');
+    if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text.c_str(), -1, result.data(), length))
+      throw std::system_error(GetLastError(), std::system_category(), "QUDA UTF-8 path conversion");
+    result.pop_back();
+    return result;
+  }
+
+  inline std::string utf8(const wchar_t *text)
+  {
+    int length = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, text, -1, nullptr, 0, nullptr, nullptr);
+    if (!length) throw std::system_error(GetLastError(), std::system_category(), "QUDA UTF-16 environment conversion");
+    std::string result(length, '\0');
+    if (!WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, text, -1, result.data(), length, nullptr, nullptr))
+      throw std::system_error(GetLastError(), std::system_category(), "QUDA UTF-16 environment conversion");
+    result.pop_back();
+    return result;
+  }
+#endif
+
+  inline std::optional<std::string> environment(const char *name)
+  {
+#ifdef _WIN32
+    const auto wide_name = utf16(name);
+    const auto *value = _wgetenv(wide_name.c_str());
+    if (value) return utf8(value);
+#else
+    const auto *value = getenv(name);
+    if (value) return std::string(value);
+#endif
+    return std::nullopt;
+  }
+
+  inline std::filesystem::path path(const std::string &name)
+  {
+#ifdef _WIN32
+    return std::filesystem::path(utf16(name));
+#else
+    return std::filesystem::path(name);
+#endif
+  }
+
+  inline bool is_directory(const std::string &name)
+  {
+    std::error_code error;
+    return std::filesystem::is_directory(path(name), error);
+  }
+
+  // The create and existence check must be one atomic filesystem operation.
+  inline int exclusive_create(const std::string &name)
+  {
+#ifdef _WIN32
+    return _wopen(path(name).c_str(), _O_WRONLY | _O_CREAT | _O_EXCL | _O_BINARY, _S_IREAD | _S_IWRITE);
+#else
+    return open(name.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0666);
+#endif
+  }
+
+  inline int write_lock(int descriptor, const char *message, unsigned int size)
+  {
+#ifdef _WIN32
+    return _write(descriptor, message, size);
+#else
+    return write(descriptor, message, size);
+#endif
+  }
+
+  inline int close_lock(int descriptor)
+  {
+#ifdef _WIN32
+    return _close(descriptor);
+#else
+    return close(descriptor);
+#endif
+  }
+
+  inline int remove_lock(const std::string &name)
+  {
+#ifdef _WIN32
+    return _wremove(path(name).c_str());
+#else
+    return remove(name.c_str());
+#endif
+  }
+} // namespace quda::host
