+namespace quda {
+  // Keep the POSIX seconds/microseconds representation used by all host timers.
+  // This type is namespace-local, so Winsock's unrelated timeval cannot collide.
+  struct timeval {
+    long long tv_sec;
+    long tv_usec;
+  };
+
+  inline int gettimeofday(timeval *time, void *)
+  {
+    static const long long frequency = [] {
+      LARGE_INTEGER value;
+      if (!QueryPerformanceFrequency(&value))
+        throw std::system_error(GetLastError(), std::system_category(), "QUDA timer frequency");
+      return value.QuadPart;
+    }();
+    LARGE_INTEGER counter;
+    if (!QueryPerformanceCounter(&counter))
+      throw std::system_error(GetLastError(), std::system_category(), "QUDA timer counter");
+    time->tv_sec = counter.QuadPart / frequency;
+    time->tv_usec = static_cast<long>((counter.QuadPart % frequency) * 1000000 / frequency);
+    return 0;
+  }
+} // namespace quda
+#else
+#include <sys/time.h>
+#endif
